{
    "name": "solid-syslog-example",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/w",
    // Root, matching docker/docker-compose.yml — see the ownership note in
    // docker-compose.yml. UID remapping is moot for root, so it is not set.
    "remoteUser": "root",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "xaver.clang-format",
                "[c]": { "editor.defaultFormatter": "xaver.clang-format" },
                "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "marus25.cortex-debug",
                "xaver.clang-format",
                "anthropic.claude-code"
            ]
        }
    },
    // Configure on start so compile_commands.json exists and the SolidSyslog
    // sources are fetched — without them there is nothing to navigate. The copy
    // is explicit rather than left to cmake.copyCompileCommands above, which only
    // fires on a CMake Tools configure: that setting keeps the root copy fresh on
    // later reconfigures, this guarantees it is there on the first open.
    "postStartCommand": "cmake --preset baseline-cross && cp build/baseline-cross/compile_commands.json compile_commands.json"
}
